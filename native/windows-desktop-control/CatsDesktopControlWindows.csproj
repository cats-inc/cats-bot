<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>cats-desktop-control-windows</AssemblyName>
    <RootNamespace>Cats.DesktopControl.Windows</RootNamespace>
    <!-- The native check and its probe app are test tools, not part of the helper. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);native-check/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
