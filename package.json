{
  "name": "@cats-inc/cats-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone always-alive desktop bots for the Cats ecosystem: one process per bot, wrapping an agent CLI through cats-runtime.",
  "author": "sammykenny2 <sammykenny2@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cats-inc/cats-bots.git"
  },
  "homepage": "https://github.com/cats-inc/cats-bots#readme",
  "bugs": {
    "url": "https://github.com/cats-inc/cats-bots/issues"
  },
  "keywords": [
    "cats",
    "bots",
    "desktop",
    "companion",
    "agent",
    "cli"
  ],
  "type": "module",
  "main": "dist/shell/electron/main.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cats-bot": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "bot": "node dist/cli/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "shell": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "@cats-inc/cats-runtime": "0.6.1",
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^41.2.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "io.catsinc.cats-bot",
    "productName": "Cats Bot",
    "copyright": "Copyright (c) 2026 sammykenny2 and contributors",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "assets/installer"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/installer/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/lib/**",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/build/koffi/win32_{ia32,arm64}/**",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/installer/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cats Bot",
      "runAfterFinish": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@41.2.0": true
  }
}
