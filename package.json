{
  "name": "@cats-inc/cats-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone always-alive desktop bots for the Cats ecosystem: one process per bot, wrapping an agent CLI through cats-runtime.",
  "author": "sammykenny2 <sammykenny2@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cats-inc/cats-bots.git"
  },
  "homepage": "https://github.com/cats-inc/cats-bots#readme",
  "bugs": {
    "url": "https://github.com/cats-inc/cats-bots/issues"
  },
  "keywords": [
    "cats",
    "bots",
    "desktop",
    "companion",
    "agent",
    "cli"
  ],
  "type": "module",
  "main": "dist/shell/electron/main.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cats-bot": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.renderer.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "bot": "node dist/cli/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "shell": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "dist:preview": "node scripts/build-preview.mjs",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "@cats-inc/cats-runtime": "file:vendor/cats-runtime-0.6.2-e38e56bf.tgz",
    "electron-updater": "6.8.9",
    "koffi": "2.16.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "io.catsinc.cats-bot",
    "productName": "Cats Bot",
    "copyright": "Copyright (c) 2026 sammykenny2 and contributors",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "assets/installer"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/installer/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/lib/**",
      "!dist/release/**",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/installer/icon.png"
    },
    "nsis": {
      "buildUniversalInstaller": false,
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cats Bot",
      "runAfterFinish": true,
      "artifactName": "Cats-Bot-${version}-setup-${arch}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "include": "assets/installer/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "buildUniversalInstaller": false,
      "artifactName": "Cats-Bot-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "files": ["!node_modules/koffi/**"],
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "artifactName": "Cats-Bot-${version}-${arch}.${ext}",
      "icon": "assets/installer/icon.png"
    },
    "linux": {
      "files": ["!node_modules/koffi/**"],
      "target": ["deb"],
      "category": "Utility",
      "executableName": "cats-bot",
      "artifactName": "Cats-Bot-${version}-${arch}.${ext}",
      "icon": "assets/installer/icon.png"
    }
  },
  "allowScripts": {
    "electron@41.2.0": true
  }
}
